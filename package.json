{
  "name": "family-finance-pwa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "preview": "wrangler pages dev dist --ip 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build && node scripts/service-worker.mjs && node scripts/build-pages.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "db:migrate": "node scripts/migrate-neon.mjs",
    "accounts:init": "node scripts/initialize-credentials.mjs",
    "check": "tsc --noEmit",
    "check:public": "node scripts/check-public.mjs",
    "backup:local": "node scripts/backup.mjs",
    "restore:check": "node scripts/check-restore.mjs",
    "format:check": "prettier --check src worker shared scripts tests vite.config.ts tsconfig.json wrangler.jsonc package.json index.html",
    "db:seed": "node scripts/seed-template.mjs",
    "backup": "node scripts/backup.mjs",
    "test:unit": "node --test tests/domain.test.mjs tests/save-queue.test.mjs tests/pwa.test.mjs tests/backup-contract.test.mjs tests/cleanup.test.mjs tests/public-files.test.mjs tests/pages-build.test.mjs tests/year-summary.test.mjs tests/chart-data.test.mjs tests/ledger.test.mjs tests/finance-charts.test.mjs tests/batch-postings.test.mjs tests/family-summary.test.mjs",
    "pretest": "npm run build",
    "pretest:unit": "npm run build"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "aws4fetch": "^1.0.20",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "fast-png": "^8.0.0",
    "hono": "^4.13.18",
    "jpeg-js": "^0.4.4",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261112.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261110.2-beta",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.161.0"
  }
}
