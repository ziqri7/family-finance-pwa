# Cloudflare Workers secrets; jangan memakai awalan VITE_ untuk rahasia.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
AWS_ENDPOINT_URL_S3=https://ENDPOINT_DARI_NEON
AWS_ACCESS_KEY_ID=TOKEN_ID_DARI_NEON
AWS_SECRET_ACCESS_KEY=SECRET_DARI_NEON
AWS_REGION=REGION_DARI_CLI_NEON
EVIDENCE_BUCKET=evidence
APP_ORIGIN=https://nama-proyek-anda.pages.dev
AUTH_USERS_JSON=[]
SESSION_SECRET=GENERATE_WITH_PRODUCTION_CREDENTIALS
# LOCAL_DEV=1 hanya di .dev.vars pada loopback.
